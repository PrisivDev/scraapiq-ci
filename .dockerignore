# =============================================================================
# .dockerignore — files excluded from the Docker build context
# =============================================================================
# Reduces build context size (faster builds, smaller cache) and prevents
# secrets / dev artifacts from leaking into the production image.
# =============================================================================

# --- Dependencies (reinstalled inside the image) ---
node_modules
**/node_modules

# --- Next.js build output (rebuilt inside the image) ---
.next
out
build

# --- Version control ---
.git
.gitignore
.gitattributes

# --- Documentation (not needed at runtime) ---
*.md
docs/

# --- Environment files (secrets — MUST be provided at runtime) ---
.env
.env.local
.env.*.local
.env.production
.env.development

# --- Logs ---
*.log
dev.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Runtime data / uploads (mounted as volumes in production) ---
upload/
download/
uploads/
downloads/

# --- Screenshots (dev artifacts) ---
screenshot-*.png
*.png
!public/*.png

# --- Agent context (internal task definitions) ---
agent-ctx/
tool-results/

# --- IDE / editor config ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS files ---
.DS_Store
Thumbs.db

# --- Docker (avoid recursive context) ---
Dockerfile
docker-compose*.yml
.dockerignore

# --- CI ---
.github/
.gitlab-ci.yml

# --- Test artifacts ---
coverage/
.nyc_output/
test-results/
playwright-report/

# --- Misc dev files ---
tsconfig.json
eslint.config.mjs
postcss.config.mjs
tailwind.config.ts
components.json
