# =============================================================================
# ScrapIQ CI — Environment Variables (Example Template)
# =============================================================================
# SaaS Web-Scraping platform for Ivory Coast (Next.js 16 + Prisma + BullMQ).
#
# HOW TO USE:
#   1. cp .env.example .env               # dev
#      cp .env.example .env.production    # prod
#   2. Generate the cryptographic secrets:
#        bash scripts/generate-secrets.sh
#      ...and paste the output over the <replace: ...> placeholders below.
#   3. Fill in the provider credentials (DB, OAuth, Stripe, Mobile Money, ...).
#   4. NEVER commit .env or .env.production — only .env.example is safe.
#
# MARKERS:
#   [CODE]     — actually read by the codebase today (src/, prisma/, mini-services/)
#   [PROD]     — anticipated for production deployment (stubs/simulations in dev)
#   [GENERATE] — must be generated (see scripts/generate-secrets.sh)
# =============================================================================


# ============================================================================
# APPLICATION
# ============================================================================
# Runtime mode: development | production
NODE_ENV=production                                                                # [CODE] read everywhere (db.ts, security-module.ts, config.ts, queue-manager.ts, middleware.ts, next.config.ts)

# Public base URL of the app (no trailing slash).
# Used by middleware.ts for CORS allowlist + cookie domain inference.
NEXT_PUBLIC_APP_URL=https://app.scraapiq.ci                                        # [CODE] src/middleware.ts → getAllowedOrigins()

# Public API base URL (used by frontend clients).
NEXT_PUBLIC_API_URL=https://app.scraapiq.ci/api                                    # [PROD] consumed by PWA / mobile / external clients

# Comma-separated list of extra origins allowed by CORS (in addition to
# NEXT_PUBLIC_APP_URL). Useful for the marketing site, mobile apps, etc.
# Example: https://scraapiq.ci,https://www.scraapiq.ci,capacitor://localhost
ALLOWED_ORIGINS=https://scraapiq.ci                                                # [CODE] src/middleware.ts → getAllowedOrigins()


# ============================================================================
# DATABASE (PostgreSQL 16 + pgvector in production; SQLite in dev)
# ============================================================================
# Connection string used by Prisma (prisma/schema.prisma → env("DATABASE_URL")).
# DEV  : "file:./dev.db"
# PROD : postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/scraapiq?schema=public           # [CODE] prisma/schema.prisma

# Direct (non-pooled) connection — used by Prisma migrations & scripts in
# serverless environments where the pooled connection (pgBouncer) doesn't
# support temporary tables / prepared statements. Leave empty if unused.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/scraapiq?schema=public             # [PROD] Prisma migrate / db:push


# ============================================================================
# AUTH & SECURITY
# ============================================================================
# All values below MUST be generated with `bash scripts/generate-secrets.sh`.
# Do NOT commit real secrets — only placeholders.

# --- JWT signing secrets ------------------------------------------------------
# Currently the codebase uses a single JWT_SECRET (src/lib/auth/jwt.ts) to sign
# both access and refresh tokens. In a future refactor these will be split into
# separate access/refresh secrets. The generator emits all three so the file is
# ready for both shapes.
JWT_SECRET=<replace: openssl rand -base64 48>                                      # [CODE]      src/lib/auth/jwt.ts — jose HS256 signing (≥32 bytes)
JWT_ACCESS_SECRET=<replace: openssl rand -base64 32>                               # [PROD]      future access-token-only signing secret
JWT_REFRESH_SECRET=<replace: openssl rand -base64 32>                              # [PROD]      future refresh-token-only signing secret

# JWT claims (currently constants in src/lib/auth/config.ts — making them env
# vars lets different deployments use different issuers without code changes).
JWT_ISSUER=scraapiq-ci                                                             # [PROD]      AUTH_CONFIG.JWT_ISSUER (currently hardcoded)
JWT_AUDIENCE=scraapiq-users                                                        # [PROD]      AUTH_CONFIG.JWT_AUDIENCE (currently hardcoded)

# --- AES-256-GCM encryption keys ---------------------------------------------
# MUST be exactly 32 bytes of UTF-8 (the cipher requires a 256-bit key).
# Generate with: openssl rand -base64 24 | tr -d '\n' | head -c 32
ENCRYPTION_KEY=<replace: openssl rand -base64 24 | tr -d '\n' | head -c 32>        # [CODE]      src/lib/security/security-module.ts (AES-256-GCM at-rest encryption)
TWOFACTOR_ENCRYPTION_KEY=<replace: openssl rand -base64 24 | tr -d '\n' | head -c 32>  # [PROD]  encrypt TOTP secrets & backup codes at rest (32-byte AES key)
SESSION_ENCRYPTION_KEY=<replace: openssl rand -base64 24 | tr -d '\n' | head -c 32>    # [PROD]  encrypt server-side session cookies (32-byte AES key)

# --- HMAC / hashing secrets ---------------------------------------------------
WEBHOOK_SIGNING_SECRET=<replace: openssl rand -base64 32>                          # [PROD]  HMAC-SHA256 signing of outbound webhooks (X-ScrapIQ-Signature)
API_KEY_SALT=<replace: openssl rand -hex 16>                                       # [PROD]  salt for hashing API keys (sk_live_…) before storage


# ============================================================================
# OAUTH PROVIDERS (Google + Microsoft)
# ============================================================================
# Create credentials at:
#   Google    : https://console.cloud.google.com/apis/credentials
#   Microsoft : https://portal.azure.com → App registrations → Microsoft Identity Platform

# --- Google ------------------------------------------------------------------
GOOGLE_CLIENT_ID=                                                                  # [CODE] src/lib/auth/oauth.ts (falls back to "demo-client-id" if empty)
GOOGLE_CLIENT_SECRET=                                                              # [CODE] src/lib/auth/oauth.ts
OAUTH_GOOGLE_CALLBACK_URL=https://app.scraapiq.ci/api/oauth/google/callback        # [PROD] must match the "Authorized redirect URIs" in Google Cloud Console

# --- Microsoft ---------------------------------------------------------------
MICROSOFT_CLIENT_ID=                                                               # [CODE] src/lib/auth/oauth.ts (falls back to "demo-client-id" if empty)
MICROSOFT_CLIENT_SECRET=                                                           # [CODE] src/lib/auth/oauth.ts
OAUTH_MICROSOFT_TENANT=common                                                      # [PROD] "common" | "organizations" | specific tenant GUID
OAUTH_MICROSOFT_CALLBACK_URL=https://app.scraapiq.ci/api/oauth/microsoft/callback  # [PROD] must match the "Redirect URI" in Azure Portal


# ============================================================================
# AI — z-ai-web-dev-sdk (LLM, VLM, embeddings)
# ============================================================================
# Read automatically by the SDK on ZAI.create(). Used by:
#   - src/lib/assistant/assistant-engine.ts (chat assistant)
#   - src/lib/scraper/sector-detector.ts   (sector classification)
#   - src/lib/scraper/ai-enricher.ts       (data enrichment)
#   - src/lib/scraper/quality-closed-detector.ts (closed-business detection)
# Verified at /api/ready.
ZAI_API_KEY=                                                                       # [CODE] src/app/api/ready/route.ts + z-ai-web-dev-sdk


# ============================================================================
# REDIS / BULLMQ (distributed queues)
# ============================================================================
# Two equivalent shapes are accepted — REDIS_URL takes priority if both are set
# (see src/app/api/ready/route.ts). Dev: leave both empty → in-memory fallback.

# Shape 1 — full URL (recommended for prod, e.g. Upstash / Elasticache)
REDIS_URL=redis://:password@redis-host:6379                                        # [CODE] src/app/api/ready/route.ts (priority over host/port/password)

# Shape 2 — separate host/port/password
REDIS_HOST=                                                                        # [CODE] src/lib/queue/config.ts, src/app/api/v1/queue/route.ts, src/app/api/ready/route.ts
REDIS_PORT=6379                                                                    # [CODE] src/lib/queue/config.ts, src/app/api/v1/queue/route.ts, src/app/api/ready/route.ts
REDIS_PASSWORD=                                                                    # [CODE] src/lib/queue/config.ts, src/app/api/ready/route.ts


# ============================================================================
# EMAIL / SMTP (notifications, invoices, scheduled reports)
# ============================================================================
# Format: smtp(s)://USER:PASSWORD@SMTP_HOST:PORT
# Providers: Resend, SendGrid, Amazon SES, Mailgun, Postmark, Brevo...
SMTP_URL=smtp://USER:PASSWORD@smtp.provider.com:587                                # [PROD] nodemailer / SendGrid integration (currently simulated in src/lib/notifications/providers.ts)
FROM_EMAIL=noreply@scraapiq.ci                                                     # [PROD] default "From" address
FROM_NAME=ScrapIQ CI                                                               # [PROD] default "From" display name


# ============================================================================
# PAYMENTS — SaaS billing (XOF / FCFA)
# ============================================================================

# --- Stripe (international cards) --------------------------------------------
STRIPE_SECRET_KEY=sk_live_xxx                                                      # [PROD] server-side Stripe API key
STRIPE_PUBLISHABLE_KEY=pk_live_xxx                                                 # [PROD] client-side Stripe key (NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is equivalent)
STRIPE_WEBHOOK_SECRET=whsec_xxx                                                    # [PROD] signs incoming Stripe webhooks (Stripe CLI: stripe listen --forward-to ...)

# --- Orange Money CI (mobile money) ------------------------------------------
# Dashboard: https://orange-api.com/
ORANGE_MONEY_CLIENT_ID=                                                            # [PROD] merchant API client id
ORANGE_MONEY_CLIENT_SECRET=                                                        # [PROD] merchant API client secret
ORANGE_MONEY_MERCHANT_KEY=                                                         # [PROD] merchant key (identifies the Orange Money account)

# --- MTN MoMo CI (mobile money) ----------------------------------------------
# Dashboard: https://momodeveloper.mtn.com/
MTN_MOMO_SUBSCRIPTION_KEY=                                                         # [PROD] Ocp-Apim-Subscription-Key (primary)
MTN_MOMO_API_USER=                                                                 # [PROD] API user id created in the sandbox/prod
MTN_MOMO_API_KEY=                                                                  # [PROD] API key for the API user


# ============================================================================
# MONITORING / OBSERVABILITY
# ============================================================================
# Sentry DSN for errors + performance (server + client).
# Leave empty to disable Sentry.
SENTRY_DSN=                                                                        # [PROD] https://xxx@oXXX.ingest.sentry.io/XXX

# Log level: debug | info | warn | error
LOG_LEVEL=info                                                                     # [PROD] used by structured logger (currently console.*)


# ============================================================================
# SCRAPING / PLAYWRIGHT
# ============================================================================
# Path to a Chromium executable. Set this in containers/CI to avoid downloading
# the full browser on every deploy. Leave empty to let Playwright auto-resolve.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium                                       # [PROD]

# Disable Chromium sandbox — required when running as root in Docker (e.g.
# official Playwright images). DANGER: do NOT enable in dev or shared hosts.
PLAYWRIGHT_NO_SANDBOX=false                                                        # [PROD] "true" only inside trusted containers

# Proxy pool for rotating scraper IPs (format: host:port;host:port;...).
# Used by Google Maps / Facebook / LinkedIn scrapers to avoid IP bans.
SCRAPER_PROXY_POOL=                                                                # [PROD] "user:pass@proxy1.example.com:8080;user:pass@proxy2.example.com:8080"
