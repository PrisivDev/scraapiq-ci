// ScrapIQ CI — Schéma Auth Enterprise
// Multi-tenant · JWT · OAuth Google/Microsoft · 2FA TOTP · RBAC · Sessions · Blacklist JWT

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ORGANISATIONS & WORKSPACES (Multi-tenant)
// ============================================================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("starter") // starter | pro | enterprise | custom
  ownerId     String
  settings    String   @default("{}") // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     Member[]
  workspaces Workspace[]
  companies   Company[]   // NEW relation — multi-tenant scoping for Company
  owner       User     @relation("OrgOwner", fields: [ownerId], references: [id])

  @@index([slug])
}

model Workspace {
  id              String   @id @default(cuid())
  name            String
  slug            String
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members         Member[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// ============================================================================
// USERS & MEMBERSHIPS (RBAC)
// ============================================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailVerified   DateTime?
  passwordHash    String?  // null si OAuth-only
  name            String?
  avatarUrl       String?
  locale          String   @default("fr")
  timezone        String   @default("Africa/Abidjan")

  // 2FA
  twoFactorEnabled    Boolean  @default(false)
  twoFactorSecret     String?  // TOTP secret (encrypted at rest)
  twoFactorBackupCodes String? // JSON array of hashed codes
  twoFactorEnabledAt  DateTime?

  // Status
  status          String   @default("active") // active | suspended | pending
  lastLoginAt     DateTime?
  lastLoginIp     String?
  failedLoginAttempts Int   @default(0)
  lockedUntil     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  ownedOrgs       Organization[] @relation("OrgOwner")
  memberships     Member[]
  accounts        Account[]         // OAuth providers
  sessions        Session[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  jwtBlacklist    JwtBlacklist[]
  apiKeys         ApiKey[]

  @@index([email])
  @@index([status])
}

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

model Member {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String
  workspaceId     String?
  role            MemberRole @default(VIEWER)
  permissions     String   @default("[]") // JSON array of permission strings
  invitedBy       String?
  invitedAt       DateTime @default(now())
  acceptedAt      DateTime?
  status          String   @default("pending") // pending | active | revoked

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, workspaceId])
  @@index([userId])
  @@index([organizationId])
}

// ============================================================================
// OAUTH ACCOUNTS (Google, Microsoft, ...)
// ============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String  // google | microsoft | github | ...
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  tokenType         String?
  scope             String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============================================================================
// SESSIONS (Server-side, used alongside JWT)
// ============================================================================

model Session {
  id            String   @id @default(cuid())
  userId        String
  token         String   @unique // opaque session token (separate from JWT)
  userAgent     String?
  ip            String?
  location      String?  // "Abidjan, CI"
  device        String?  // parsed from UA
  lastSeenAt    DateTime @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?  // logout | expired | security | admin
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// REFRESH TOKENS (Rotating, with family for replay detection)
// ============================================================================

model RefreshToken {
  id            String   @id @default(cuid())
  userId        String
  token         String   @unique // hashed refresh token
  family        String   // family ID (rotating tokens share a family)
  session       String?  // linked session id
  userAgent     String?
  ip            String?
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  revokedReason String?  // used | rotated | logout | replay_detected | admin
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
}

// ============================================================================
// JWT BLACKLIST (Revoked access tokens before expiry)
// ============================================================================

model JwtBlacklist {
  id            String   @id @default(cuid())
  userId        String
  jti           String   @unique // JWT ID (claim)
  reason        String   @default("logout") // logout | breach | admin | password_change
  expiresAt     DateTime // when the original JWT would have expired (auto-purge)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// API KEYS (programmatic access, separate from JWT)
// ============================================================================

model ApiKey {
  id            String   @id @default(cuid())
  userId        String
  name          String
  keyHash       String   @unique
  keyPrefix     String   // first 8 chars for display
  scopes        String   @default("[]") // JSON array
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// SAAS — LICENCES, ABONNEMENTS, FACTURATION, QUOTA
// ============================================================================

model License {
  id            String   @id @default(cuid())
  key           String   @unique @default(cuid())
  plan          String   // starter | pro | enterprise | custom
  name          String   // nom du plan acheté
  maxUsers      Int      @default(5)
  maxCompanies  Int      @default(10000)
  maxApiCalls   Int      @default(100000)
  maxExports    Int      @default(100)
  maxSources    Int      @default(3)
  maxWorkspaces Int      @default(1)
  features      String   @default("[]") // JSON array of feature strings
  status        String   @default("inactive") // inactive | active | suspended | expired
  activatedAt   DateTime?
  expiresAt     DateTime?
  organizationId String? // null = non activée
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([key])
  @@index([status])
  @@index([organizationId])
}

model Subscription {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  licenseId           String?
  plan                String   @default("starter") // starter | pro | enterprise | custom
  status              String   @default("trialing") // trialing | active | past_due | cancelled | expired
  billingCycle        String   @default("monthly") // monthly | yearly
  amountXOF           Int      @default(25000) // FCFA
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean  @default(false)
  paymentMethod       String?  // orange_money | mtn_momo | moov | card | bank_transfer
  providerSubId       String?  // ID côté fournisseur de paiement
  trialEndsAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model Invoice {
  id              String   @id @default(cuid())
  organizationId  String
  subscriptionId  String?
  number          String   @unique // INV-2026-001
  amountXOF       Int      // montant en FCFA
  taxXOF          Int      @default(0) // TVA 18%
  totalXOF        Int      // amount + tax
  status          String   @default("pending") // pending | paid | void | refunded
  dueDate         DateTime
  paidAt          DateTime?
  items           String   @default("[]") // JSON array of line items
  pdfUrl          String?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([status])
  @@index([number])
}

model QuotaUsage {
  id              String   @id @default(cuid())
  organizationId  String
  periodYear      Int
  periodMonth     Int
  apiCalls        Int      @default(0)
  companiesStored Int      @default(0)
  exportsCount    Int      @default(0)
  scrapeJobs      Int      @default(0)
  usersCount      Int      @default(0)
  updatedAt       DateTime @default(now())

  @@unique([organizationId, periodYear, periodMonth])
  @@index([organizationId])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String   // login | logout | login_failed | 2fa_enable | token_revoked | ...
  category      String   // auth | security | oauth | twofactor | session | api
  severity      String   @default("info") // debug | info | warn | error | critical
  ip            String?
  userAgent     String?
  metadata      String   @default("{}") // JSON
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([category, createdAt])
}

// ============================================================================
// COMPANIES (REST API CRUD — exposed via /api/v1/companies)
// ============================================================================

model Company {
  id              String   @id @default(cuid())
  organizationId  String?   // null = global/shared (visible OWNER only), set = org-scoped
  name            String
  sector          String?
  commune         String?
  city            String?
  address         String?
  phone           String?
  email           String?
  website         String?
  rccm            String?
  lat             Float?
  lng             Float?
  rating          Float?
  reviewCount     Int?
  status          String   @default("active") // active | closed | relocated
  description     String?
  employees       String?
  sources         String   @default("[]") // JSON array
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
  @@index([sector])
  @@index([city])
  @@index([commune])
  @@index([status])
  @@index([organizationId])  // NEW index for tenant filtering
}

// ============================================================================
// REST API LOGS (audit trail for all REST API calls)
// ============================================================================

model RestApiLog {
  id          String   @id @default(cuid())
  method      String
  endpoint    String
  statusCode  Int
  responseMs  Int
  ip          String?
  userAgent   String?
  apiKeyId    String?
  userId      String?
  error       String?
  createdAt   DateTime @default(now())

  @@index([endpoint])
  @@index([createdAt])
  @@index([userId])
}

// ============================================================================
// WEBHOOKS (outbound event delivery)
// ============================================================================

model Webhook {
  id          String   @id @default(cuid())
  url         String
  events      String   @default("[]") // JSON array of event names
  secret      String?  // signing secret
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  WebhookDelivery[]

  @@index([isActive])
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  webhookId   String
  event       String
  payload     String   @default("{}") // JSON
  statusCode  Int?
  response    String?
  status      String   @default("pending") // pending | success | failed | retry
  attempts    Int      @default(0)
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// NOTIFICATIONS (multi-canal : email, SMS, WhatsApp, push, webhook)
// ============================================================================

model Notification {
  id          String   @id @default(cuid())
  userId      String?
  channel     String   // email | sms | whatsapp | push | webhook | in_app
  title       String
  body        String
  payload     String   @default("{}") // JSON
  status      String   @default("pending") // pending | sent | delivered | failed | read
  priority    String   @default("normal") // low | normal | high | critical
  recipient   String?  // email, phone, device token, webhook URL
  senderId    String?  // who triggered
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  error       String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@index([priority])
}

// ============================================================================
// ALERT RULES (règles d'alerte automatiques)
// ============================================================================

model AlertRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  metric      String   // quota_usage | scrape_failures | source_degraded | companies_added | dedup_rate
  condition   String   // gt | lt | gte | lte | eq | contains
  threshold   Float
  channels    String   @default("[\"in_app\"]") // JSON array of channels
  isActive    Boolean  @default(true)
  lastTriggeredAt DateTime?
  triggerCount Int     @default(0)
  cooldownMin Int      @default(30) // min entre 2 déclenchements
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([metric])
}

// ============================================================================
// SCHEDULED REPORTS (rapports automatiques)
// ============================================================================

model ScheduledReport {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   // daily | weekly | monthly | custom
  schedule    String   // cron expression or simple: "daily:08:00", "weekly:mon:08:00"
  channels    String   @default("[\"email\"]") // JSON array
  recipients  String   @default("[]") // JSON array of emails/phones
  filters     String   @default("{}") // JSON : sectors, cities, etc.
  format      String   @default("pdf") // pdf | xlsx | csv | json
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  runCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions  ReportExecution[]

  @@index([isActive])
  @@index([nextRunAt])
}

model ReportExecution {
  id          String   @id @default(cuid())
  reportId    String
  status      String   @default("pending") // pending | processing | completed | failed
  format      String
  fileSizeBytes Int?
  filename    String?
  dataUrl     String?  // base64 for small files
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  report      ScheduledReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// SCRAPE JOB RECORDS (persistent history of scraping jobs)
// ============================================================================
// The in-memory store (src/lib/scraper/job-store.ts) keeps live state
// (Playwright instance, recent events, currentPlace) but is wiped on server
// restart. ScrapeJobRecord is the durable history row that survives restarts
// and powers GET /api/scraper/jobs (list) + GET /api/scraper/jobs/[id] (detail)
// even after the in-memory state has been garbage-collected.
//
// The `jobId` field is the in-memory job ID (e.g. "scrape-ab12cd34"); it is
// unique so we can merge live + historical state on read.

model ScrapeJobRecord {
  id                 String    @id @default(cuid())
  jobId              String    @unique // in-memory job ID (scrape-xxxx)
  organizationId     String?   // null = global/OWNER-only (mirrors SearchQuery.organizationId)
  userId             String?   // null = no authenticated user (shouldn't happen in practice)
  keyword            String
  city               String?
  commune            String?
  neighborhood       String?
  status             String    @default("queued") // queued | running | completed | failed | cancelled
  progress           Int       @default(0) // 0-100
  resultsCount       Int       @default(0)
  processedCount     Int       @default(0)
  duplicatesDetected Int       @default(0)
  errors             String    @default("[]") // JSON array of error strings
  duration           Int?      // milliseconds (set on completion/failure)
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}
