# =============================================================================
# ScrapIQ CI — .env.production.example
# =============================================================================
# Safe-to-commit template for production deployments. Copy to `.env.production`
# and fill in the real values — NEVER commit the real `.env.production`.
#
#   cp .env.production.example .env.production
#   bash scripts/generate-secrets.sh --write .env.production   # overwrites the 8 secrets
#   # then manually edit DATABASE_URL, REDIS_URL, OAuth, Stripe, SMTP, ZAI_API_KEY ...
#   bash scripts/generate-secrets.sh --check .env.production   # must exit 0
#
# This file mirrors .env.production exactly so a diff is a useful audit tool.
# All secret-shaped values use `<replace: ...>` markers so they cannot be
# mistaken for working credentials.
# =============================================================================

# --- Application ---
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.scraapiq.ci
NEXT_PUBLIC_API_URL=https://app.scraapiq.ci/api
ALLOWED_ORIGINS=https://scraapiq.ci

# --- Database (PostgreSQL 16 + pgvector) ---
# Docker service name `postgres` resolves inside the compose network.
# The POSTGRES_PASSWORD env on the postgres container MUST match the password below.
DATABASE_URL="postgresql://scraapiq:<replace: openssl rand -base64 24 | tr -d '\n/+='>@postgres:5432/scraapiq?schema=public"
DIRECT_URL="postgresql://scraapiq:<replace: same password as DATABASE_URL>@postgres:5432/scraapiq?schema=public"

# --- JWT signing secrets (generated) ---
JWT_SECRET=<replace: openssl rand -base64 48>
JWT_ACCESS_SECRET=<replace: openssl rand -base64 32>
JWT_REFRESH_SECRET=<replace: openssl rand -base64 32>
JWT_ISSUER=scraapiq-ci
JWT_AUDIENCE=scraapiq-users

# --- AES-256-GCM encryption keys (generated, 32-byte UTF-8) ---
ENCRYPTION_KEY=<replace: openssl rand -base64 24 | tr -d '\n' | head -c 32>
TWOFACTOR_ENCRYPTION_KEY=<replace: openssl rand -base64 24 | tr -d '\n' | head -c 32>
SESSION_ENCRYPTION_KEY=<replace: openssl rand -base64 24 | tr -d '\n' | head -c 32>

# --- HMAC / hashing secrets (generated) ---
WEBHOOK_SIGNING_SECRET=<replace: openssl rand -base64 32>
API_KEY_SALT=<replace: openssl rand -hex 16>

# --- OAuth providers (fill in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=https://app.scraapiq.ci/api/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common
OAUTH_MICROSOFT_CALLBACK_URL=https://app.scraapiq.ci/api/oauth/microsoft/callback

# --- AI (z-ai-web-dev-sdk) ---
ZAI_API_KEY=

# --- Redis / BullMQ ---
# Docker service name `redis` resolves inside the compose network.
REDIS_URL=redis://redis:6379

# --- Email / SMTP ---
SMTP_URL=smtp://<replace: USER:PASSWORD>@smtp.provider.com:587
FROM_EMAIL=noreply@scraapiq.ci
FROM_NAME=ScrapIQ CI

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

# --- Monitoring / observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Scraping / Playwright ---
PLAYWRIGHT_NO_SANDBOX=true
SCRAPER_PROXY_POOL=

# --- Production bootstrap (scripts/seed-prod.ts) ---
# Used once to create the first OWNER user + Organization on a fresh DB.
# ADMIN_PASSWORD must satisfy the policy: ≥8 chars + 1 upper + 1 lower + 1 digit + 1 special.
# Change after first login. ⚠️ Rotate this value once bootstrap is complete.
ADMIN_EMAIL=admin@scraapiq.ci
ADMIN_PASSWORD=<replace: strong password, e.g. AdminProd!2026>
ADMIN_NAME=Administrateur
ADMIN_ORG_NAME=ScrapIQ CI — Organisation
